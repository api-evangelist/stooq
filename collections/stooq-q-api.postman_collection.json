      "item": [
        {
          "id": "39f59252-331a-4d6b-abe7-21b5bf13b43f",
          "name": "Download historical OHLCV data as CSV",
          "request": {
            "name": "Download historical OHLCV data as CSV",
            "description": {
              "content": "Returns a CSV file containing OHLCV (Open, High, Low, Close, Volume) time-series data for the specified ticker symbol and date range. Covers 21,000+ global securities and ETFs, 1,980+ currency pairs, 130+ cryptocurrencies, global indices, commodities, and economic indicators. Daily history extends 30+ years for major instruments; hourly data spans ~9 months; 5-minute data ~1 month.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "q",
                "d",
                "l",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "s",
                  "value": "<string>",
                  "description": "(Required) Ticker symbol, optionally suffixed with an exchange code. Examples: aapl.us (Apple US), googl.us, btc.v (Bitcoin), gbp.v (GBP/USD), oil (crude oil), spx (S&P 500). Exchange suffixes: .US, .UK, .DE, .JP, .HK, .HU, .V"
                },
                {
                  "disabled": false,
                  "key": "d1",
                  "value": "<string>",
                  "description": "Start date for the data range in YYYYMMDD format."
                },
                {
                  "disabled": false,
                  "key": "d2",
                  "value": "<string>",
                  "description": "End date for the data range in YYYYMMDD format."
                },
                {
                  "disabled": false,
                  "key": "i",
                  "value": "d",
                  "description": "Data interval. Options: d (daily), w (weekly), m (monthly), q (quarterly), y (yearly). Intraday intervals also supported: 60 (hourly, ~9 months history), 5 (5-minute, ~1 month history)."
                },
                {
                  "disabled": false,
                  "key": "apikey",
                  "value": "<string>",
                  "description": "(Required) API key obtained from the Stooq website via a CAPTCHA form. Required as of early 2026."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/csv"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
